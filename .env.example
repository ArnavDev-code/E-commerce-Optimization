# ============================================
# FunnelLeak AI - Environment Configuration
# ============================================
# Copy this file to .env and fill in values

# --- Database ---
DATABASE_URL=postgresql://funnel:funnel@localhost:5432/funnelleak

# --- Application ---
SECRET_KEY=change-this-to-a-random-secret-in-production
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Shopify Integration (optional in demo mode) ---
# Create a Shopify app at https://partners.shopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_inventory,read_locations
SHOPIFY_API_VERSION=2026-10
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/shopify/oauth/callback

# --- Google Analytics 4 Integration (optional) ---
# Step 1: Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
#   - Application type: Web application
#   - Authorised redirect URI: http://localhost:8000/api/integrations/ga4/callback (dev)
# Step 2: Enable the Google Analytics Admin API and Google Analytics Data API
# Step 3: Fill in the values below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/ga4/callback
# Scope - do not change, read-only access to GA4 only
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/analytics.readonly

# Legacy service-account GA4 (unused when OAuth is active)
GA4_CREDENTIALS_PATH=
GA4_PROPERTY_ID=

# --- LLM Provider (optional - uses deterministic fallback if missing) ---
# Options: openai, anthropic, gemini, fallback
LLM_PROVIDER=fallback
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production. If empty, a deterministic dev key is derived from SECRET_KEY (not production-safe).
ENCRYPTION_KEY=
