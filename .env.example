# ============================================
# FunnelLeak AI - Environment Configuration
# ============================================
# Copy this file to .env and fill in values

# --- Database ---
DATABASE_URL=postgresql://funnel:funnel@localhost:5432/funnelleak

# --- Application ---
SECRET_KEY=change-this-to-a-random-secret-in-production
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173

# --- Shopify Integration (optional in demo mode) ---
# Create a Shopify app at https://partners.shopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_inventory
SHOPIFY_API_VERSION=2026-10

# --- GA4 Integration (optional) ---
# Service account JSON key file path
GA4_CREDENTIALS_PATH=
# GA4 Property ID (numeric, e.g., 123456789)
GA4_PROPERTY_ID=

# --- LLM Provider (optional - uses deterministic fallback if missing) ---
# Options: openai, anthropic, fallback
LLM_PROVIDER=fallback
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
